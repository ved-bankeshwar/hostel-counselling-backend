# Database Configuration (Local PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=room_counselling
DB_USER=postgres
DB_PASSWORD=postgres

# Firebase Configuration
# Convert your serviceAccountKey.json to base64 using:
# $content = Get-Content serviceAccountKey.json -Raw; $bytes = [System.Text.Encoding]::UTF8.GetBytes($content); [Convert]::ToBase64String($bytes)
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Optional: If you prefer to use the file directly (not recommended for production)
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Application Settings
PORT=8000
ENVIRONMENT=local
